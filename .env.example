# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Enterprise Data Intelligence Platform 2026"
VERSION="1.0.0"
DEBUG=true

# Server & API Settings
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_USER=datapulse_user
POSTGRES_PASSWORD=datapulse_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datapulse_warehouse

# Async Database URL (for FastAPI / SQLAlchemy async engine)
ASYNC_DATABASE_URL=postgresql+asyncpg://datapulse_user:datapulse_password@localhost:5432/datapulse_warehouse

# Sync Database URL (for Alembic / Airflow / PostgreSQL)
SYNC_DATABASE_URL=postgresql+psycopg2://datapulse_user:datapulse_password@localhost:5432/datapulse_warehouse

# Storage Paths
STORAGE_RAW_PATH=./data/raw
STORAGE_PROCESSED_PATH=./data/processed
STORAGE_QUARANTINE_PATH=./data/quarantine

# Security
SECRET_KEY=super_secret_jwt_key_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Intelligence Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Airflow Pipeline Orchestration
AIRFLOW_HOST=http://localhost:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin

# Power BI Analytics & Web Dashboard Configuration
POWERBI_DASHBOARD_ENABLED=true
POWERBI_DATASET_PATH=./data/raw
